# Copy this file to .env and fill in your keys
# .env is gitignored — never commit actual keys

# Groq API key (free) — preferred: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenAI key — fallback if GROQ_API_KEY is not set
# OPENAI_API_KEY=sk-...

# Kaggle credentials (only needed for raw data download)
# Get them from: https://www.kaggle.com/settings/account -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
